ASSISTANT_NAME=RAMADAN
# If connected to ESP32 fallback access point, use http://192.168.4.1
# If connected through your router, replace with the ESP32 station IP.
ESP32_URL=http://192.168.4.1
# Must match METER_ADMIN_KEY in the ESP32 sketch (for protected meter mode/top-up routes).
ESP32_API_TOKEN=CHANGE_ME_TO_THE_SAME_METER_ADMIN_KEY
WHISPER_MODEL=base
# Local-only TTS on this same PC; no domain or public server required.
TTS_SERVICE_URL=http://127.0.0.1:8766
DATABASE_PATH=ramatech_home_ai_payments.db
# Optional only if you deliberately configure Flutterwave test mode.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_HASH=
PUBLIC_BASE_URL=
